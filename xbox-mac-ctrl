#!/usr/bin/env python3
"""
Xbox Controller → macOS Full Keyboard Mapper
============================================
Uses macOS GameController framework (Bluetooth & USB).
Sends keystrokes via AppleScript System Events.

REQUIRES: Accessibility permission
  System Settings → Privacy & Security → Accessibility → add Terminal.app

╔══════════════════════════════════════════════════════╗
║               DEFAULT MAPPING                        ║
╠══════════╦══════════════╦════════════════════════════╣
║  BUTTON  ║    ACTION    ║  DESCRIPTION               ║
╠══════════╬══════════════╬════════════════════════════╣
║  A       ║  Left Click  ║  Mouse Click               ║
║  B       ║  Cmd+[       ║  Browser Back              ║
║  X       ║  Space       ║  Play/Pause                ║
║  Y       ║  Right Click ║  Context Menu              ║
║  LB      ║  Left Arrow  ║  Seek Back / Prev Page     ║
║  RB      ║  Right Arrow ║  Seek Fwd  / Next Page     ║
║  LT ░░   ║  Up Arrow    ║  Scroll Up  (pressure=speed)║
║  RT ░░   ║  Down Arrow  ║  Scroll Down(pressure=speed)║
║  D-Up    ║  Volume Up   ║  System Volume +           ║
║  D-Down  ║  Volume Down ║  System Volume -           ║
║  D-Left  ║  Cmd+Shift+[ ║  Previous Tab              ║
║  D-Right ║  Cmd+Shift+] ║  Next Tab                  ║
║  LS ░░   ║  Mouse Move  ║  Cursor (analog)           ║
║  LSB     ║  Left Click  ║  Mouse Click               ║
║  RS ░░   ║  Mouse Move  ║  Cursor (analog)           ║
║  RSB     ║  Cmd+W       ║  Close Tab                 ║
║  Start   ║  Cmd+Space   ║  Spotlight                 ║
║  Select  ║  Escape      ║  Exit / Cancel             ║
║  Xbox    ║  Launchpad   ║  App Launcher              ║
║  Share   ║  Cmd+Shift+3 ║  Full Screenshot           ║
╚══════════╩══════════════╩════════════════════════════╝
  ░░ = analog input (pressure-sensitive, variable rate)

Usage:
  xbox-mac-ctrl                                 # Default mapping
  xbox-mac-ctrl --help                          # Show all options
  xbox-mac-ctrl --reading                       # Reading mode (微信读书 etc)
  xbox-mac-ctrl --xbox=launchpad                # Custom Xbox button
  xbox-mac-ctrl --share=none                    # Disable Share button
"""

import os
import sys
import time
import signal
import subprocess

import objc
import Quartz
from Foundation import (
    NSNotificationCenter, NSRunLoop, NSDate, NSTimer, NSObject, NSLog
)
from GameController import (
    GCController, GCControllerDidConnectNotification,
    GCControllerDidDisconnectNotification
)


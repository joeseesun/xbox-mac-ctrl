READING = {
    "face":      ["space",    "escape",   "f",       "m"],
    "shoulders": ["pageup",   "pagedown"],
    "triggers":  ["up",       "down"],
    "dpad":      ["volume-up","volume-down","j",    "l"],
    "lstick":    ["left",     "right",    "up",       "down",     "cmd+t"],

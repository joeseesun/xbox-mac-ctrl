# ═══════════════════════════════════════════════════════════════
#  PARSE ARGS
# ═══════════════════════════════════════════════════════════════

def _parse_args():
    cfg = DEFAULT.copy()

    if "--reading" in sys.argv:
        cfg = READING.copy()

    for arg in sys.argv:
        if arg == "--help" or arg == "-h":
            print(__doc__)
            sys.exit(0)
        for key in ["face", "shoulders", "triggers", "dpad", "lstick", "rstick", "sys", "xbox", "share"]:
            if arg.startswith(f"--{key}="):
                cfg[key] = [k.strip() for k in arg.split("=", 1)[1].split(",")]

    return cfg


CFG = _parse_args()


def _resolve(key_name):
    """Resolve a key name to (key_code, modifiers_list) or ("special", name)."""
    name = key_name.strip().lower()
    if name == "none":
        return None, []
    if name in ("click", "rightclick", "volume-up", "volume-down", "launchpad"):
        return ("special", name)
    entry = KEY_TABLE.get(name)
    if entry is None:
        print(f"[xctrl] ⚠ Unknown key: {name}")
        return None, []
    return entry


# ═══════════════════════════════════════════════════════════════
#  CGEvent KEY SENDER (bypasses input method!)
# ═══════════════════════════════════════════════════════════════

def _send_key(key_code, modifiers):
    """Send keystroke via CGEvent — bypasses Chinese input method."""
    if key_code is None and not modifiers:
        return

    # ── Mouse click ──
    if key_code == "special" and modifiers == "click":
        pos = Quartz.CGEventGetLocation(Quartz.CGEventCreate(None))
        down = Quartz.CGEventCreateMouseEvent(None, Quartz.kCGEventLeftMouseDown, pos, 0)
        up = Quartz.CGEventCreateMouseEvent(None, Quartz.kCGEventLeftMouseUp, pos, 0)
        Quartz.CGEventPost(Quartz.kCGSessionEventTap, down)
        Quartz.CGEventPost(Quartz.kCGSessionEventTap, up)
        return

    if key_code == "special" and modifiers == "rightclick":
        pos = Quartz.CGEventGetLocation(Quartz.CGEventCreate(None))
        down = Quartz.CGEventCreateMouseEvent(None, Quartz.kCGEventRightMouseDown, pos, 0)
        up = Quartz.CGEventCreateMouseEvent(None, Quartz.kCGEventRightMouseUp, pos, 0)
        Quartz.CGEventPost(Quartz.kCGSessionEventTap, down)
        Quartz.CGEventPost(Quartz.kCGSessionEventTap, up)
        return

    # ── Volume (AppleScript — no CGEvent API) ──
    if key_code == "special" and modifiers == "volume-up":
        subprocess.run(["osascript", "-e", _VOL_UP], capture_output=True, timeout=3)
        return
    if key_code == "special" and modifiers == "volume-down":
        subprocess.run(["osascript", "-e", _VOL_DOWN], capture_output=True, timeout=3)
        return

    # ── Launchpad (AppleScript) ──
    if key_code == "special" and modifiers == "launchpad":
        subprocess.run(["osascript", "-e",
            'tell application "Launchpad" to activate'], capture_output=True, timeout=3)
        return

    if key_code is None or key_code == "special":
        return

    # ── Keyboard via CGEvent ──
    mods = modifiers if isinstance(modifiers, list) else [modifiers]
    flags = 0
    for m in mods:
        flags |= _CG_FLAGS.get(m, 0)

    NSLog(f"[xctrl] CGEvent kc={key_code} down flags={flags}")
    event = Quartz.CGEventCreateKeyboardEvent(None, key_code, True)
    if flags:
        Quartz.CGEventSetFlags(event, flags)
    Quartz.CGEventPost(Quartz.kCGSessionEventTap, event)

    # Brief pause to let the system register the key-down
    time.sleep(0.01)

    event = Quartz.CGEventCreateKeyboardEvent(None, key_code, False)
    Quartz.CGEventPost(Quartz.kCGSessionEventTap, event)
    NSLog(f"[xctrl] CGEvent kc={key_code} up")


# ═══════════════════════════════════════════════════════════════
#  ANALOG REPEATER — variable-rate key repeat for sticks/triggers
# ═══════════════════════════════════════════════════════════════

class AnalogTrigger:
    """Sends a key at variable rate based on analog value (for LT/RT)."""
    def __init__(self, key_code, modifiers, deadzone=0.25):
        self.key_code = key_code
        self.modifiers = modifiers if isinstance(modifiers, list) else [modifiers]
        self.deadzone = deadzone
        self.value = 0.0
        self.last_trigger = 0.0

    def update(self, value):
        self.value = value

    def tick(self):
        if self.value < self.deadzone:
            return
        t = (self.value - self.deadzone) / (1.0 - self.deadzone)
        interval = 0.20 - t * 0.15  # 200ms → 50ms
        now = time.monotonic()
        if now - self.last_trigger >= interval:
            _send_key(self.key_code, self.modifiers)
            self.last_trigger = now


class StickAxis:
    """Handles one stick axis with two directions."""
    def __init__(self, neg_key_code, neg_mods, pos_key_code, pos_mods,
                 deadzone=0.25, threshold=0.30):
        self.neg_key = neg_key_code       # negative direction
        self.neg_mods = neg_mods if isinstance(neg_mods, list) else [neg_mods]
        self.pos_key = pos_key_code       # positive direction
        self.pos_mods = pos_mods if isinstance(pos_mods, list) else [pos_mods]
        self.name = "axis"
        self.deadzone = deadzone
        self.threshold = threshold
        self.value = 0.0
        self.last_neg = 0.0
        self.last_pos = 0.0

    def update(self, value):
        self.value = value

    def tick(self):
        av = abs(self.value)
        if av < self.threshold:
            return

        # Variable rate: threshold→200ms, 1.0→80ms
        t = (av - self.threshold) / (1.0 - self.threshold)
        interval = 0.20 - t * 0.12
        now = time.monotonic()

        if self.value < -self.threshold and self.neg_key is not None:
            if now - self.last_neg >= interval:
                NSLog(f"[xctrl] {self.name} → key {self.neg_key}")
                _send_key(self.neg_key, self.neg_mods)
                self.last_neg = now

        if self.value > self.threshold and self.pos_key is not None:
            if now - self.last_pos >= interval:
                NSLog(f"[xctrl] {self.name} → key {self.pos_key}")
                _send_key(self.pos_key, self.pos_mods)
                self.last_pos = now


class MouseStick:
    """Maps analog stick to mouse cursor movement."""
    def __init__(self, deadzone=0.15, max_speed=18):
        self.deadzone = deadzone
        self.max_speed = max_speed
        self.x = 0.0
        self.y = 0.0

    def update_x(self, value):
        self.x = value

    def update_y(self, value):
        self.y = value

    def tick(self):
        ax, ay = abs(self.x), abs(self.y)
        if ax < self.deadzone and ay < self.deadzone:
            return

        def speed(v):
            if abs(v) < self.deadzone:
                return 0
            t = (abs(v) - self.deadzone) / (1.0 - self.deadzone)
            return self.max_speed * (t ** 2) * (1 if v > 0 else -1)

        dx = speed(self.x)
        dy = speed(self.y)
        if dx == 0 and dy == 0:
            return

        pos = Quartz.CGEventGetLocation(Quartz.CGEventCreate(None))
        new_x = pos.x + dx
        new_y = pos.y - dy  # negate: stick ↑ = screen Y↓
        event = Quartz.CGEventCreateMouseEvent(
            None, Quartz.kCGEventMouseMoved, (new_x, new_y), 0
        )
        Quartz.CGEventPost(Quartz.kCGSessionEventTap, event)


# ═══════════════════════════════════════════════════════════════
#  CONTROLLER — main handler
# ═══════════════════════════════════════════════════════════════

DEBOUNCE_SEC = 0.18

class Controller(NSObject):
    def init(self):
        self = objc.super(Controller, self).init()
        if self is None:
            return None
        self.gamepad = None
        self.connected_ctrl = None
        self.last_times = {}
        self._handler_refs = {}
        self.scan_retries = 0

        # Analog components (processed by tick_)
        self._triggers = []    # list of AnalogTrigger
        self._stick_axes = []  # list of StickAxis
        self._mouse_stick = None  # MouseStick or None

        return self

    # ── Digital button handler ──────────────────────────
    def _make_digital(self, btn_name, key_name):
        kc, mods = _resolve(key_name)
        if kc is None and key_name != "none":
            return None

        def handler(button, value, pressed):
            try:
                if not pressed:
                    return
                now = time.monotonic()
                last = self.last_times.get(btn_name, 0)
                if now - last < DEBOUNCE_SEC:
                    return
                self.last_times[btn_name] = now
                NSLog(f"[xctrl] {btn_name} → {key_name}")
                _send_key(kc, mods)
            except Exception as e:
                NSLog(f"[xctrl] {btn_name} error: {e}")
        return handler

    # ── Analog trigger handler (LT/RT) ──────────────────
    def _make_trigger(self, key_name):
        kc, mods = _resolve(key_name)
        if kc is None and key_name != "none":
            return None
        trigger = AnalogTrigger(kc, mods)
        self._triggers.append(trigger)

        def handler(button, value, pressed):
            trigger.update(value)
        return handler

    # ── Stick axis handler ──────────────────────────────
    def _make_stick_axis(self, neg_key, pos_key, name=""):
        nkc, nmods = _resolve(neg_key)
        pkc, pmods = _resolve(pos_key)
        axis = StickAxis(nkc, nmods, pkc, pmods)
        axis.name = name
        self._stick_axes.append(axis)

        def handler(axis_input, value):
            axis.update(value)
        return handler

    # ── Setup ───────────────────────────────────────────
    def _setup_gamepad(self, ctrl):
        gp = ctrl.extendedGamepad()
        if not gp:
            return False

        self._triggers = []
        self._stick_axes = []
        self._mouse_stick = None
        refs = {}

        def bind_digital(button, name, key_name):
            h = self._make_digital(name, key_name)
            if h:
                refs[name] = h
                button.setValueChangedHandler_(h)

        def bind_trigger(button, key_name):
            h = self._make_trigger(key_name)
            if h:
                refs[key_name] = h
                button.setValueChangedHandler_(h)

        def bind_axis(axis_input, neg_key, pos_key, name=""):
            h = self._make_stick_axis(neg_key, pos_key, name)
            if h:
                # key is not used for retrieval, just keep alives
                refs[id(axis_input)] = h
                axis_input.setValueChangedHandler_(h)

        # Face buttons: A, B, X, Y
        for i, (btn, name) in enumerate([
            (gp.buttonA(), "A"), (gp.buttonB(), "B"),
            (gp.buttonX(), "X"), (gp.buttonY(), "Y"),
        ]):
            if i < len(CFG["face"]):
                bind_digital(btn, name, CFG["face"][i])

        # Shoulders: LB, RB
        if len(CFG["shoulders"]) >= 2:
            bind_digital(gp.leftShoulder(),  "LB", CFG["shoulders"][0])
            bind_digital(gp.rightShoulder(), "RB", CFG["shoulders"][1])

        # Triggers: LT, RT (analog)
        if len(CFG["triggers"]) >= 2:
            bind_trigger(gp.leftTrigger(),  CFG["triggers"][0])
            bind_trigger(gp.rightTrigger(), CFG["triggers"][1])

        # D-Pad
        if len(CFG["dpad"]) >= 4:
            bind_digital(gp.dpad().up(),    "D-Up",    CFG["dpad"][0])
            bind_digital(gp.dpad().down(),  "D-Down",  CFG["dpad"][1])
            bind_digital(gp.dpad().left(),  "D-Left",  CFG["dpad"][2])
            bind_digital(gp.dpad().right(), "D-Right", CFG["dpad"][3])

        # Both sticks → shared mouse cursor
        self._mouse_stick = MouseStick()
        ms = self._mouse_stick

        # Left Stick
        ls = gp.leftThumbstick()
        lhx = lambda inp, v: ms.update_x(v)
        lhy = lambda inp, v: ms.update_y(v)
        refs["lsx"] = lhx; refs["lsy"] = lhy
        ls.xAxis().setValueChangedHandler_(lhx)
        ls.yAxis().setValueChangedHandler_(lhy)
        if hasattr(gp, 'leftThumbstickButton'):
            bind_digital(gp.leftThumbstickButton(), "LSB", CFG["lstick"][4])

        # Right Stick — same MouseStick, shared cursor
        rs = gp.rightThumbstick()
        rhx = lambda inp, v: ms.update_x(v)
        rhy = lambda inp, v: ms.update_y(v)
        refs["rsx"] = rhx; refs["rsy"] = rhy
        rs.xAxis().setValueChangedHandler_(rhx)
        rs.yAxis().setValueChangedHandler_(rhy)
        if hasattr(gp, 'rightThumbstickButton'):
            bind_digital(gp.rightThumbstickButton(), "RSB", CFG["rstick"][4])

        # System buttons: View (Select), Menu (Start)
        if len(CFG["sys"]) >= 2:
            if hasattr(gp, 'buttonOptions'):
                bind_digital(gp.buttonOptions(), "Select", CFG["sys"][0])
            bind_digital(gp.buttonMenu(), "Start", CFG["sys"][1])

        # Xbox Logo button → Launchpad (may be intercepted by macOS ≥11)
        if CFG.get("xbox") and len(CFG["xbox"]) >= 1:
            if hasattr(gp, 'buttonHome'):
                bind_digital(gp.buttonHome(), "Xbox", CFG["xbox"][0])

        # Share button (Xbox Series X|S) → Screenshot
        if CFG.get("share") and len(CFG["share"]) >= 1:
            if hasattr(gp, 'buttonShare'):
                bind_digital(gp.buttonShare(), "Share", CFG["share"][0])

        self._handler_refs = refs
        self.gamepad = gp
        self.connected_ctrl = ctrl

        name = ctrl.vendorName() or "Xbox Controller"
        print(f"[xctrl] ✓ {name}")
        self._print_mapping()
        print(f"[xctrl] Ready.")
        self.scan_retries = 0
        return True

    def _print_mapping(self):
        lines = []
        for group, keys in CFG.items():
            if group == "sys":
                lines.append(f"  Select={keys[0]}  Start={keys[1]}")
            elif group == "xbox":
                lines.append(f"  Xbox={keys[0]}")
            elif group == "share":
                lines.append(f"  Share={keys[0]}")
            else:
                lines.append(f"  {group}: {', '.join(keys)}")
        for line in lines:
            print(f"[xctrl]{line}")

    def _teardown_gamepad(self):
        if self.gamepad:
            for inp in [
                self.gamepad.buttonA(), self.gamepad.buttonB(),
                self.gamepad.buttonX(), self.gamepad.buttonY(),
                self.gamepad.leftShoulder(), self.gamepad.rightShoulder(),
                self.gamepad.leftTrigger(), self.gamepad.rightTrigger(),
                self.gamepad.dpad().up(), self.gamepad.dpad().down(),
                self.gamepad.dpad().left(), self.gamepad.dpad().right(),
                self.gamepad.leftThumbstickButton() if hasattr(self.gamepad, 'leftThumbstickButton') else None,
                self.gamepad.rightThumbstickButton() if hasattr(self.gamepad, 'rightThumbstickButton') else None,
                self.gamepad.buttonMenu(),
            ]:
                if inp is not None:
                    inp.setValueChangedHandler_(None)
            self.gamepad.leftThumbstick().xAxis().setValueChangedHandler_(None)
            self.gamepad.leftThumbstick().yAxis().setValueChangedHandler_(None)
            self.gamepad.rightThumbstick().xAxis().setValueChangedHandler_(None)
            self.gamepad.rightThumbstick().yAxis().setValueChangedHandler_(None)
        self.gamepad = None
        self.connected_ctrl = None
        self._handler_refs = {}
        self._triggers = []
        self._stick_axes = []
        self._mouse_stick = None

    # ── Notifications ────────────────────────────────────
    def onControllerConnect_(self, note):
        ctrl = note.object()
        if self._setup_gamepad(ctrl):
            NSLog(f"[xctrl] Controller connected: {ctrl.vendorName()}")

    def onControllerDisconnect_(self, note):
        NSLog("[xctrl] Controller disconnected")
        self._teardown_gamepad()
        print("[xctrl] Controller disconnected. Waiting for reconnect...")

    # ── Tick (30Hz) — analog repeaters + reconnection scan ──
    def tick_(self, timer):
        for t in self._triggers:
            t.tick()
        for a in self._stick_axes:
            a.tick()
        if self._mouse_stick:
            self._mouse_stick.tick()

        # Reconnection scan (every ~5s)
        if not self.gamepad:
            self.scan_retries += 1
            if self.scan_retries % 150 == 0:
                for c in GCController.controllers():
                    if self._setup_gamepad(c):
                        return


# ═══════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════

def _check_accessibility():
    result = subprocess.run(
        ["osascript", "-e",
         'tell application "System Events" to get name of first process'],
        capture_output=True, timeout=3
    )
    return result.returncode == 0


def main():
    print(f"[xctrl] Starting (PID={os.getpid()})...")

    # ── Accessibility check ──
    if _check_accessibility():
        print(f"[xctrl] ✓ Accessibility permission OK")
    else:
        print(f"[xctrl] ✗ Accessibility permission MISSING")
        print(f"[xctrl]   → System Settings → Privacy & Security → Accessibility")
        print(f"[xctrl]   → Add your terminal app, then re-run")

    # ── Print mapping ──
    print(f"[xctrl] Press any button on the controller to wake it.")

    # ── Create pager ──
    ctrl_handler = Controller.alloc().init()

    for c in GCController.controllers():
        if ctrl_handler._setup_gamepad(c):
            break

    # ── Notifications ──
    center = NSNotificationCenter.defaultCenter()
    center.addObserver_selector_name_object_(
        ctrl_handler, "onControllerConnect:", GCControllerDidConnectNotification, None
    )
    center.addObserver_selector_name_object_(
        ctrl_handler, "onControllerDisconnect:", GCControllerDidDisconnectNotification, None
    )

    GCController.startWirelessControllerDiscoveryWithCompletionHandler_(None)

    # ── Tick timer: ~30Hz for analog input + reconnection ──
    NSTimer.scheduledTimerWithTimeInterval_target_selector_userInfo_repeats_(
        0.033, ctrl_handler, "tick:", None, True
    )

    # ── Signal handling ──
    running = [True]
    def _shutdown(sig, frame):
        running[0] = False
    signal.signal(signal.SIGINT, _shutdown)
    signal.signal(signal.SIGTERM, _shutdown)

    # ── Main run loop ──
    runloop = NSRunLoop.currentRunLoop()
    while running[0]:
        runloop.runUntilDate_(NSDate.dateWithTimeIntervalSinceNow_(0.5))

    # ── Cleanup ──
    ctrl_handler._teardown_gamepad()
